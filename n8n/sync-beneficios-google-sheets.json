    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ESTADO ACTUAL DE TODOS LOS CLIENTES (tab \"leads\")\n-- Una fila por cliente. El ciclo 'abierto' es el actual: solo puede haber\n-- uno por cliente (lo garantiza uq_ciclo_abierto_por_cliente).\n-- Los coalesce cubren al cliente que todavia no tiene ningun pago PayPal:\n-- en ese caso no tiene ciclo abierto y los joins traen null.\nselect\n  c.id::text                                                as cliente_id,\n  c.nombre_visible                                          as cliente,\n  c.identificacion                                          as ruc,\n  c.email                                                   as correo,\n  case when c.activo then 'Activo' else 'Archivado' end     as estado_cliente,\n  coalesce(cg.numero, 0)                                    as ciclo_actual,\n  round(coalesce(cg.acumulado, 0), 2)                       as acumulado_ciclo,\n  round(greatest(5000  - coalesce(cg.acumulado, 0), 0), 2)  as falta_para_5k,\n  round(greatest(10000 - coalesce(cg.acumulado, 0), 0), 2)  as falta_para_10k,\n  case when cg.umbral_5k_pago_id  is not null then 'Si' else 'No' end as gano_6_meses,\n  case when cg.umbral_10k_pago_id is not null then 'Si' else 'No' end as gano_12_meses,\n  round(coalesce(s.saldo_cashback, 0), 2)                   as cashback_ganado,\n  round(coalesce(s.cashback_redimido, 0), 2)                as cashback_redimido,\n  round(coalesce(s.cashback_disponible, 0), 2)              as cashback_disponible,\n  -- El cashback se puede redimir a partir de USD 20 (regla del programa).\n  case when coalesce(s.cashback_disponible, 0) >= 20 then 'Si' else 'No' end as puede_redimir,\n  to_char(now() at time zone 'America/Guayaquil', 'YYYY-MM-DD HH24:MI') as actualizado\nfrom public.clientes c\nleft join public.ciclos_garantia cg\n       on cg.cliente_id = c.id and cg.estado = 'abierto'\nleft join public.saldo_por_cliente s\n       on s.cliente_id = c.id\norder by coalesce(cg.acumulado, 0) desc, c.nombre_visible;",
        "options": {}
      },
      "id": "a1f0c6e2-0002-4a10-9f01-000000000002",
      "name": "Query estado de clientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-180, -140]
    },
