    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- GARANTIAS DESBLOQUEADAS (tab \"beneficios obtenidos\")\n-- Una fila por beneficio otorgado. Es historico: sobrevive al reinicio del\n-- ciclo, porque la garantia pertenece a la cotizacion, no al ciclo.\n-- 'Vigente' / 'Expirada' NO se guardan en la tabla: se deducen contra la\n-- fecha de hoy, para no depender de un proceso nocturno.\nselect\n  g.id::text                           as garantia_id,\n  c.nombre_visible                     as cliente,\n  c.identificacion                     as ruc,\n  c.email                              as correo,\n  coalesce(g.cotizacion_numero, '')    as cotizacion,\n  coalesce(g.deal_nombre, '')          as negocio,\n  g.umbral::int                        as umbral_cruzado,\n  round(g.monto_pago, 2)               as monto_del_pago,\n  round(g.acumulado_alcanzado, 2)      as acumulado_al_cruzar,\n  g.meses_fabrica,\n  g.meses_extension,\n  g.meses_totales,\n  to_char(g.fecha_inicio,    'YYYY-MM-DD') as garantia_desde,\n  to_char(g.fecha_fin_total, 'YYYY-MM-DD') as garantia_hasta,\n  case\n    when g.estado = 'revocada_por_limite' then 'Revocada (desplazada)'\n    when g.fecha_fin_total < current_date then 'Expirada'\n    else 'Vigente'\n  end                                  as situacion,\n  coalesce(g.cotizacion_url, '')       as link_cotizacion,\n  to_char(g.created_at at time zone 'America/Guayaquil', 'YYYY-MM-DD HH24:MI') as desbloqueada_en\nfrom public.garantias_extendidas g\njoin public.clientes c on c.id = g.cliente_id\norder by g.created_at desc;",
        "options": {}
      },
